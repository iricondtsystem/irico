# WordPress-style versioned assets with @ver in filename
/wp-includes/*
  Cache-Control: public, max-age=31536000, immutable
/wp-content/plugins/*
  Cache-Control: public, max-age=31536000, immutable
/wp-content/themes/*
  Cache-Control: public, max-age=31536000, immutable
/wp-includes/js/jquery/*
  Cache-Control: public, max-age=31536000, immutable
/wp-content/plugins/happy-elementor-addons/assets/vendor/dom-purify/*
  Cache-Control: public, max-age=31536000, immutable
/wp-content/plugins/happy-elementor-addons/assets/vendor/gsap/*
  Cache-Control: public, max-age=31536000, immutable

# OHIF DICOM viewer static assets - cache long
/dicom-viewer/*.wasm
  Cache-Control: public, max-age=31536000, immutable
/dicom-viewer/*.js
  Cache-Control: public, max-age=31536000, immutable
/dicom-viewer/*.css
  Cache-Control: public, max-age=31536000, immutable
/dicom-viewer/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/dicom-viewer/sw.js
  Cache-Control: no-cache
/dicom-viewer/index.html
  Cache-Control: no-cache
/dicom-viewer/app-config.js
  Cache-Control: no-cache