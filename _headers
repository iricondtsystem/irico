# OHIF DICOM viewer static assets - cache long
/dicom-viewer/*.wasm
  Cache-Control: public, max-age=31536000, immutable
/dicom-viewer/*.js
  Cache-Control: public, max-age=31536000, immutable
/dicom-viewer/*.css
  Cache-Control: public, max-age=31536000, immutable
/dicom-viewer/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/dicom-viewer/sw.js
  Cache-Control: no-cache
/dicom-viewer/index.html
  Cache-Control: no-cache
/dicom-viewer/app-config.js
  Cache-Control: no-cache